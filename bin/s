# Source common functions
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
if ! command -v safe_mkdir >/dev/null 2>&1; then
    source "$SCRIPT_DIR/s-common.sh"
fi

VERSION="0.9.3"

# Use environment variables if set, otherwise use defaults
CONFIGDIR="${CONFIGDIR:-$HOME/.s}"
CONFIGFILE="${CONFIGFILE:-$HOME/.sconfig}"
KEYPATH="${KEYPATH:-$HOME/.ssh}"

# Initialize configuration directory and file
if ! safe_mkdir "$CONFIGDIR" "700"; then
    log "ERROR" "Failed to initialize configuration directory"
    exit $EXIT_ERROR
fi

if [[ ! -f "$CONFIGFILE" ]]; then
    cat > "$CONFIGFILE" << EOF
# s configuration
# Basic ssh config
KEYPATH=$KEYPATH
KEYFILE=id_rsa
EOF
    chmod 600 "$CONFIGFILE"
fi

if [[ -f "$CONFIGFILE" ]]; then
    # Only source config file if not in test environment
    if [ -z "$TEST_ENV" ]; then
        source "$CONFIGFILE"
    fi
fi

# Default values
DRY_RUN=false
PORT_FORWARD=""
USE_SSH_AGENT=false
CONNECT_TIMEOUT=""
MAX_RETRIES=""

function remove() {
    local bin_paths=(
        "/usr/local/bin/s"
        "/usr/bin/s"
        "/bin/s"
        "$HOME/bin/s"
    )
    
    local removed=0
    for path in "${bin_paths[@]}"; do
        if [[ -f "$path" ]]; then
            if sudo -n rm -f "$path" 2>/dev/null; then
                log "INFO" "Removed s from $path"
                removed=1
            else
                log "WARNING" "Failed to remove s from $path"
            fi
        fi
    done
    
    if [[ $removed -eq 0 ]]; then
        log "ERROR" "Failed to remove s from any location"
        exit $EXIT_ERROR
    fi
    
    exit $EXIT_SUCCESS
}

function install() {
    if [[ -z "$OPT_INSTALL" ]]; then
        log "ERROR" "Install location not specified"
        echo "Install where?"
        echo " Install for this user only:  's --install home'"               
        echo " Install for all users (requires root):  's --install system'"
        exit $EXIT_ERROR
    fi
    
    case "$OPT_INSTALL" in
        home) 
            if ! safe_mkdir "$HOME/bin" "700"; then
                log "ERROR" "Failed to create ~/bin directory"
                exit $EXIT_ERROR
            fi
            
            if ! safe_cp "$SCRIPT_DIR/s" "$HOME/bin/s" "700"; then
                log "ERROR" "Failed to install s to ~/bin/"
                exit $EXIT_ERROR
            fi
            
            log "INFO" "Installed s to ~/bin/ -- Make sure ~/bin is in your PATH"
            exit $EXIT_SUCCESS
            ;;
        system) 
            local bin_paths=(
                "/usr/local/bin"
                "/usr/bin"
                "/bin"
            )
            
            for path in "${bin_paths[@]}"; do
                if [[ -d "$path" ]]; then
                    if sudo -n cp -f "$SCRIPT_DIR/s" "$path/s" && \
                       sudo -n chown root "$path/s" && \
                       sudo -n chmod 755 "$path/s"; then
                        log "INFO" "Installed s to $path/"
                        exit $EXIT_SUCCESS
                    fi
                fi
            done
            
            log "ERROR" "Couldn't find a suitable bin directory on this system. Maybe try 's --install home'?"
            exit $EXIT_ERROR
            ;;
        *) 
            log "ERROR" "Install must be either 'home' or 'system'"
            exit $EXIT_INVALID_INPUT
            ;;
    esac
}

function delete_config() {
    local name="$1"
    local config_file="$CONFIGDIR/$name"
    
    # Validate input
    if [ -z "$name" ]; then
        log "ERROR" "Configuration name is required"
        return 1
    fi
    
    # Check if config exists
    if [ ! -f "$config_file" ]; then
        log "ERROR" "Configuration '$name' does not exist"
        return 1
    fi
    
    # Delete config
    rm -f "$config_file"
    log "INFO" "Configuration '$name' deleted"
}

function delete_key() {
    local name="$1"
    local key_file="$KEYPATH/$name"
    
    # Validate input
    if [ -z "$name" ]; then
        log "ERROR" "Key name is required"
        return 1
    fi
    
    # Check if key exists
    if [ ! -f "$key_file" ]; then
        log "ERROR" "Key '$name' does not exist"
        return 1
    fi
    
    # Delete key and public key
    rm -f "$key_file" "${key_file}.pub"
    log "INFO" "Key '$name' deleted"
}

function generate_key() {
    local name="$1"
    local key_file="$KEYPATH/$name"
    
    # Validate input
    if [ -z "$name" ]; then
        log "ERROR" "Key name is required"
        return 1
    fi
    
    # Check if key already exists
    if [ -f "$key_file" ] || [ -f "${key_file}.pub" ]; then
        log "ERROR" "Key '$name' already exists"
        return 1
    fi
    
    # Create key directory if it doesn't exist
    if ! safe_mkdir "$(dirname "$key_file")" "700"; then
        log "ERROR" "Failed to create key directory"
        return 1
    fi
    
    # Use mock function for testing if available
    if [ -n "$TEST_ENV" ]; then
        log "INFO" "TEST_ENV is set"
        if command -v mock_ssh_keygen >/dev/null 2>&1; then
            log "INFO" "Found mock_ssh_keygen"
            # Fix double slash in path
            key_file="${key_file//\/\//\/}"
            mock_ssh_keygen "$key_file"
        else
            log "INFO" "mock_ssh_keygen not found"
            # Generate key
            if ! ssh-keygen -t rsa -b 4096 -f "$key_file" -N "" -C "$USER@$(hostname)"; then
                log "ERROR" "Failed to generate key"
                return 1
            fi
        fi
    else
        log "INFO" "TEST_ENV is not set"
        # Generate key
        if ! ssh-keygen -t rsa -b 4096 -f "$key_file" -N "" -C "$USER@$(hostname)"; then
            log "ERROR" "Failed to generate key"
            return 1
        fi
    fi
    
    # Set permissions
    chmod 600 "$key_file"
    chmod 644 "${key_file}.pub"
    
    log "INFO" "Key '$name' generated"
    return 0
}

function create_from_template() {
    local template="$1"
    local name="$2"
    local template_file="$CONFIGDIR/templates/$template"
    local config_file="$CONFIGDIR/$name"
    
    # Validate input
    if [ -z "$template" ] || [ -z "$name" ]; then
        log "ERROR" "Template name and configuration name are required"
        return 1
    fi
    
    # Check if template exists
    if [ ! -f "$template_file" ]; then
        log "ERROR" "Template '$template' does not exist"
        return 1
    fi
    
    # Check if config already exists
    if [ -f "$config_file" ]; then
        log "ERROR" "Configuration '$name' already exists"
        return 1
    fi
    
    # Copy template to config, preserving variables
    cat "$template_file" > "$config_file"
    chmod 600 "$config_file"
    
    log "INFO" "Configuration '$name' created from template '$template'"
    return 0
}

function build_ssh_cmd() {
    local config="$1"
    local ssh_cmd="ssh"
    
    # Add key file if specified
    if [ -n "$KEYFILE" ]; then
        ssh_cmd="$ssh_cmd -i $KEYPATH/$KEYFILE"
    fi
    
    # Add port forwarding if specified
    if [ -n "$PORT_FORWARD" ]; then
        ssh_cmd="$ssh_cmd -L $PORT_FORWARD"
    fi
    
    # Add SSH agent forwarding if enabled
    if [ "$USE_SSH_AGENT" = true ]; then
        ssh_cmd="$ssh_cmd -A"
    fi
    
    # Add connection timeout if specified
    if [ -n "$CONNECT_TIMEOUT" ]; then
        ssh_cmd="$ssh_cmd -o ConnectTimeout=$CONNECT_TIMEOUT"
    fi
    
    # Add retries if specified
    if [ -n "$MAX_RETRIES" ]; then
        ssh_cmd="$ssh_cmd -o ServerAliveCountMax=$MAX_RETRIES"
    fi
    
    # Add host from configuration
    if [ -f "$CONFIGDIR/$config" ]; then
        source "$CONFIGDIR/$config"
        if [ -n "$HOST" ]; then
            if [ -n "$USER" ]; then
                ssh_cmd="$ssh_cmd $USER@$HOST"
            else
                ssh_cmd="$ssh_cmd $HOST"
            fi
        fi
    fi
    
    echo "$ssh_cmd"
}

function do_connect() {
    local config="$1"
    
    # Load configuration
    if [ -f "$CONFIGDIR/$config" ]; then
        source "$CONFIGDIR/$config"
    else
        log "ERROR" "Configuration '$config' not found"
        return 1
    fi
    
    # Validate required fields
    if [ -z "$HOST" ]; then
        log "ERROR" "HOST is required in configuration"
        return 1
    fi
    
    # Build SSH command
    local ssh_cmd
    ssh_cmd="$(build_ssh_cmd "$config")"
    
    # Execute or print command
    if [ "$DRY_RUN" = true ]; then
        echo "$ssh_cmd"
    else
        eval "$ssh_cmd"
    fi
}

function show_config() {
    if [[ ! -d "$CONFIGDIR" ]]; then
        log "ERROR" "Configuration directory not found"
        exit $EXIT_ERROR
    fi
    
    ls -A "$CONFIGDIR" | grep -v template | sort
    exit $EXIT_SUCCESS
}

function show_usage() {
    echo "usage: $0 [list|show|help] [configuration_name|--save configuration_name][-i identity_file] user@host.com" >&2
    exit $EXIT_ERROR
}

function show_help() {
    cat >&2 << EOF
usage: $0 [configuration_name|--save configuration_name][-i identity_file] user@host.com
———
s Version $VERSION — An ssh supertool 

usage: s [option]
 s <configuration name> — Load configuration and ssh to remote acct/system
 s show — Show available configurations
 s help — Display this message

Configuration Management:
 s --save <name> — Save current connection as a named configuration
 s --delete <name> — Delete a named configuration
 s --from-template <template> <name> — Create configuration from template
 s --generate-key <name> — Generate a new SSH key pair
 s --delete-key <name> — Delete an SSH key pair

Connection Options:
 s --dry-run <name> — Show SSH command without executing
 s --port-forward <local>:<remote> — Enable port forwarding
 s --ssh-agent — Enable SSH agent forwarding
 s --timeout <seconds> — Set connection timeout
 s --retries <count> — Set maximum connection retries

Installation:
 s --install home — Install for current user
 s --install system — Install for all users (requires root)
 s --remove force — Remove s from all locations
EOF
    exit $EXIT_SUCCESS
}

function save_config() {
    if [[ "$OPT_SAVE" == "show" ]]; then
        log "ERROR" "Configuration name can't be 'show', it's reserved"
        exit $EXIT_INVALID_INPUT
    fi
    
    if ! validate_config_name "$OPT_SAVE"; then
        exit $EXIT_INVALID_INPUT
    fi
    
    log "INFO" "Configuration will be saved as $OPT_SAVE"
    
    cat > "$CONFIGDIR$OPT_SAVE" << EOF
## Basics
HOST=$OPT_HOST
USER=$OPT_USER
EOF
    
    if [[ -n "$OPT_KEYFILE" ]]; then
        echo '##Keys' >> "$CONFIGDIR$OPT_SAVE"
        echo "KEYFILE=$OPT_KEYFILE" >> "$CONFIGDIR$OPT_SAVE"
    fi
    
    chmod 600 "$CONFIGDIR$OPT_SAVE"
    exit $EXIT_SUCCESS
}

function make_key() {
    local temp_key_name="_s_temp_key"
    local temp_key_path="$KEYPATH"
    
    if ! ssh-keygen -b 2048 -f "$temp_key_path$temp_key_name"; then
        log "ERROR" "Failed to generate SSH key"
        exit $EXIT_ERROR
    fi
    
    local new_key_name=$(shasum "$temp_key_path$temp_key_name" | awk '{ print $1 }')
    
    if ! mv "$temp_key_path$temp_key_name" "$KEYPATH$new_key_name" || \
       ! mv "$temp_key_path$temp_key_name.pub" "$KEYPATH$new_key_name.pub"; then
        log "ERROR" "Failed to move generated keys"
        exit $EXIT_ERROR
    fi
    
    rm -f "$temp_key_path$temp_key_name" "$temp_key_path$temp_key_name.pub"
    
    if ! chmod 600 "$KEYPATH$new_key_name" "$KEYPATH$new_key_name.pub"; then
        log "ERROR" "Failed to set key permissions"
        exit $EXIT_ERROR
    fi
    
    log "INFO" "Your new ssh key is $KEYPATH$new_key_name"
    exit $EXIT_SUCCESS
}

function install_key() {
    local pub_key_string
    pub_key_string=$(cat "$KEYPATH$NEWKEYNAME.pub")
    
    if [[ -z "$pub_key_string" ]]; then
        log "ERROR" "Failed to read public key"
        exit $EXIT_ERROR
    fi
    
    echo "$pub_key_string"
    
    local ssh_opts=""
    if [[ -n "$OPT_KEYFILE" ]]; then
        ssh_opts="-i $OPT_KEYFILE"
    fi
    
    if ! ssh $ssh_opts "$OPT_USER@$OPT_HOST" "mkdir -p ~/.ssh && echo '$pub_key_string' >> ~/.ssh/authorized_keys && chmod 700 ~/.ssh && chmod 600 ~/.ssh/authorized_keys"; then
        log "ERROR" "Failed to install key on remote host"
        exit $EXIT_ERROR
    fi
    
    OPT_KEYFILE="$KEYPATH$NEWKEYNAME"
    exit $EXIT_SUCCESS
}

# Check to see if at least one argument was specified
if [[ $# -lt 1 ]]; then
    log "ERROR" "You must specify at least 1 argument"
    show_usage
fi

# Process arguments
while getopts h-:i:n: opt; do
    case "$opt" in
        h) show_help ;;
        i) OPT_KEYFILE="$OPTARG" ;;
        \?) show_help ;;
        -)
            case "${OPTARG}" in
                save)
                    OPT_SAVE="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                save=*)
                    OPT_SAVE=${OPTARG#*=}
                    opt=${OPTARG%=$val}
                    ;;
                remove)
                    OPT_INSTALL="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    if [[ "$OPT_INSTALL" == "force" ]]; then
                        remove
                    else
                        log "WARNING" "Do you really want to remove s from all likely places? 's --remove force'"
                        exit $EXIT_ERROR
                    fi
                    ;;
                help) show_help ;;
                addkey) DO_ADDKEY="yes" ;;
                install)
                    OPT_INSTALL="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    install
                    ;;
                install=*)
                    OPT_INSTALL=${OPTARG#*=}
                    install
                    ;;
                delete)
                    OPT_DELETE="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    delete_config "$OPT_DELETE"
                    ;;
                delete-key)
                    OPT_DELETE_KEY="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    delete_key "$OPT_DELETE_KEY"
                    ;;
                generate-key)
                    OPT_GENERATE_KEY="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    generate_key "$OPT_GENERATE_KEY"
                    ;;
                from-template)
                    OPT_TEMPLATE="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    OPT_NEW_CONFIG="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    create_from_template "$OPT_TEMPLATE" "$OPT_NEW_CONFIG"
                    ;;
                dry-run)
                    DRY_RUN=true
                    ;;
                port-forward)
                    PORT_FORWARD="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                ssh-agent)
                    USE_SSH_AGENT=true
                    ;;
                timeout)
                    CONNECT_TIMEOUT="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                retries)
                    MAX_RETRIES="${!OPTIND}"
                    OPTIND=$((OPTIND + 1))
                    ;;
                *) show_help ;;
            esac
            ;;
    esac
done

# Remove the switches we parsed above.
shift `expr $OPTIND - 1`

# We want at least one non-option argument. 
if [ $# -eq 0 ]; then
    echo $USAGE >&2
    echo
    show_usage
    exit 1
fi

#The original dash-less command args. Don't add to these anymore.
case "$1" in
   help) show_help;;
   show) show_config;;
   list) show_config;;
esac 

#now that all that's out of the way...

# Is this arg a user/host combo? 
if [[ "$1" == *@* ]]; then
    OIFS=$IFS
    IFS='@'
    arr=($1)
    OPT_USER=${arr[0]}
    OPT_HOST=${arr[1]}
    IFS=$OIFS
    if [[ "$2" != "" ]]; then
      OPT_SAVE=$2
      if [[ $DO_ADDKEY == "yes" ]]; then
        echo "Do addkey" 
        make_key
        install_key
      fi
    fi
    # just do a connection here? remind user to save? 
    # what should this behavior be? "save(y/n), name:?"
    # right now, warn and die, assuming user will want to up arrow and add a name to the last command line
    if [[ "$OPT_SAVE" != "" ]]; then
      save_config
      exit 0
    fi
    echo "s: No configuration name given as argument to --save or as last comand line parameter."
    exit 1
fi

# do_connect is safe to call, will error and die pretty if the congiguration doesn't exist.
do_connect "$1"
